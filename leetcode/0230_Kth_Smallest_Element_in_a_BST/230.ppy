from collections import deque
from typing import List, Optional


# Definition for a binary tree node.
class TreeNode:
    def __init__(self, val=0, left=None, right=None):
        self.val = val
        self.left = left
        self.right = right


# Helper function to build a binary tree from LeetCode level-order array representation
def build_tree(vals: List[Optional[int]]) -> Optional[TreeNode]:
    if not vals:
        return None
    root = TreeNode(vals[0])
    queue = deque([root])
    i = 1
    while queue and i < len(vals):
        node = queue.popleft()
        if i < len(vals) and vals[i] is not None:
            node.left = TreeNode(vals[i])
            queue.append(node.left)
        i += 1
        if i < len(vals) and vals[i] is not None:
            node.right = TreeNode(vals[i])
            queue.append(node.right)
        i += 1
    return root

# 230. Kth Smallest Element in a BST
# Leave this empty for your implementation
class Solution:
    def kthSmallest(self, root: Optional[TreeNode], k: int) -> int:
        i = 0

        def dfs(node: TreeNode | None) -> TreeNode | None:
            if node is None:
                return None
            nonlocal i
            left = dfs(node.left)
            if left:
                return left
            i += 1
            if i == k:
                return node
            right = dfs(node.right)
            if right:
                return right

        node = dfs(root)
        return node.val


# --- Test Suite ---
def run_tests():
    sol = Solution()

    test_cases = [
        # (Input level-order array, Input k, Expected output, Description)
        ([3, 1, 4, None, 2], 1, 1, "k is 1 (Example 1)"),
        ([5, 3, 6, 2, 4, None, None, 1], 3, 3, "k is middle element (Example 2)"),
        ([1], 1, 1, "Single node tree"),
        ([2, 1, 3], 3, 3, "k equals total number of nodes (Largest element)"),
        (
            [5, 3, 6, 2, 4, None, None, 1],
            6,
            6,
            "k equals total number of nodes in deep tree",
        ),
        ([4, 2, 5, 1, 3], 2, 2, "Second smallest in balanced BST"),
        ([1, None, 2, None, 3, None, 4], 3, 3, "Right-skewed tree"),
        ([4, 3, None, 2, None, 1], 1, 1, "Left-skewed tree"),
        ([10, 5, 15, 3, 7, 12, 18], 4, 10, "Balanced BST finding median node"),
    ]

    all_passed = True
    for i, (tree_list, k, expected, desc) in enumerate(test_cases, 1):
        root = build_tree(tree_list)
        result = sol.kthSmallest(root, k)
        if result == expected:
            print(f"✅ Test {i} Passed: {desc}")
        else:
            print(f"❌ Test {i} Failed: {desc}")
            print(f"   Input Tree: {tree_list}, k = {k}")
            print(f"   Expected: {expected}, but got: {result}")
            all_passed = False

    print("-" * 30)
    if all_passed:
        print("🎉 All test cases passed!")
    else:
        print("⚠️ Some test cases failed. Review your logic.")


if __name__ == "__main__":
    run_tests()
